{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Usage Checker",
  "version": "0.1.0",
  "identifier": "com.jazz23.claudeusagechecker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude Usage",
        "width": 480,
        "height": 250,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 230
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
